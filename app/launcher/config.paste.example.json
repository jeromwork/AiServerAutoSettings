{
  "kind": "remoteagents-config",
  "schema": 1,
  "device": {
    "name": "Мой компьютер"
  },
  "server": {
    "address": "server.example.invalid",
    "port": 22,
    "login": "remoteagents",
    "key": {
      "secret": "server-key"
    },
    "routes": [
      {
        "kind": "direct"
      }
    ]
  },
  "connection": {
    "enabled": true
  },
  "bridge": {
    "enabled": true,
    "allowShell": false
  },
  "happier": {
    "mode": "same",
    "label": "Мой аккаунт",
    "serverUrl": "https://api.example.invalid",
    "webappUrl": "https://web.example.invalid",
    "key": {
      "secret": "happier-key"
    }
  },
  "vpn": {
    "enabled": false
  },
  "components": {
    "transport": {
      "enabled": true
    },
    "control": {
      "enabled": true
    },
    "vpn": {
      "enabled": false
    }
  },
  "secrets": {
    "server-key": "",
    "happier-key": "",
    "cloud-password": ""
  },
  "cloud": {
    "vendor": "mailru",
    "login": "user@mail.ru",
    "password": {
      "secret": "cloud-password",
      "hint": "Пароль для внешних приложений Mail"
    },
    "remoteRoot": "Disk",
    "pollSeconds": 20
  }
}
