{
  "kind": "remoteagents-config",
  "schema": 1,
  "device": {
    "name": "Мой компьютер"
  },
  "server": {
    "address": "server.example.invalid",
    "port": 22,
    "login": "remoteagents",
    "key": {
      "secret": "server-key"
    },
    "routes": [
      {
        "kind": "direct"
      }
    ]
  },
  "connection": {
    "enabled": true
  },
  "agent": {
    "sudo": "full"
  },
  "bridge": {
    "enabled": true,
    "allowShell": true
  },
  "happier": {
    "mode": "same",
    "label": "Мой аккаунт",
    "serverUrl": "https://api.example.invalid",
    "webappUrl": "https://web.example.invalid",
    "key": {
      "secret": "happier-key"
    }
  },
  "disk": {
    "folders": [
      {
        "id": "Проект"
      },
      {
        "id": "Документы"
      }
    ]
  },
  "vpn": {
    "enabled": false
  },
  "components": {
    "transport": {
      "enabled": true
    },
    "disk": {
      "enabled": true
    },
    "control": {
      "enabled": true
    },
    "vpn": {
      "enabled": false
    }
  },
  "secrets": {
    "server-key": "",
    "happier-key": ""
  },
  "update": {
    "enabled": true,
    "auto": true,
    "intervalHours": 6,
    "remoteDir": "~/.local/share/remote-agents/dist"
  },
  "lan": [
    {
      "name": "office",
      "kind": "openvpn",
      "testHost": "10.123.0.10",
      "testPort": 22,
      "subnets": [
        "10.123.0.0/24"
      ],
      "share": {
        "subnets": [
          "10.123.0.0/24"
        ],
        "domains": [
          "*.example.org"
        ],
        "dnsServers": [
          "10.123.0.53"
        ],
        "enabled": true
      }
    }
  ]
}
