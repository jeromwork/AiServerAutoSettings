{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Персональное обновление зарегистрированного компьютера",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "serverAddress",
    "serverPort",
    "workerUser",
    "hostKeys",
    "routes",
    "expiresUtc",
    "vpn",
    "bootstrap",
    "type",
    "deviceId",
    "deviceKey"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "serverAddress": {
      "type": "string",
      "minLength": 1
    },
    "serverPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "workerUser": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
    },
    "hostKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "direct",
              "proxy",
              "hop"
            ]
          },
          "proxy": {
            "type": "object",
            "required": [
              "type",
              "host",
              "port"
            ],
            "properties": {
              "type": {
                "enum": [
                  "socks",
                  "http"
                ]
              },
              "host": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "additionalProperties": false
          },
          "hop": {
            "type": "object",
            "required": [
              "ssh",
              "hostKey"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "ssh": {
                "type": "string"
              },
              "hostKey": {
                "type": "string"
              },
              "privateKey": {
                "type": "string"
              },
              "password": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "expiresUtc": {
      "type": "string",
      "format": "date-time"
    },
    "vpn": {
      "enum": [
        "on",
        "off"
      ]
    },
    "bootstrap": {
      "type": "object",
      "required": [
        "catalog"
      ],
      "properties": {
        "catalog": {
          "type": "object",
          "required": [
            "schema"
          ],
          "properties": {
            "schema": {
              "const": 1
            }
          }
        },
        "channel": {
          "type": "object"
        },
        "entries": {
          "type": "object"
        },
        "hops": {
          "type": "object"
        },
        "vpn": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "type": {
      "const": "refresh"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "deviceKey": {
      "type": "string",
      "pattern": "^ssh-ed25519 [A-Za-z0-9+/=]+$"
    }
  }
}
