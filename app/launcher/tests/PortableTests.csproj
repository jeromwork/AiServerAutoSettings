<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Exe</OutputType>
    <StartupObject Condition="'$(ConfigTests)' == 'true'">RemoteAgents.Launcher.ConfigBundleTests</StartupObject>
    <StartupObject Condition="'$(ConfigE2E)' == 'true'">RemoteAgents.Launcher.ConfigE2E</StartupObject>
    <StartupObject Condition="'$(ConfigTests)' != 'true' And '$(ConfigE2E)' != 'true'">RemoteAgents.Launcher.TestEntry</StartupObject>
    <DefineConstants>PORTABLE_TEST</DefineConstants>
    <DefineConstants Condition="'$(ProductName)' == 'RemoteVPN'">PORTABLE_TEST;REMOTE_VPN</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>SYSLIB0014;SYSLIB0057;CA1416</NoWarn>
  </PropertyGroup>
  <!-- A different entry point must not reuse the other build's output (StartupObject alone does not trigger a rebuild). -->
  <PropertyGroup Condition="'$(ConfigTests)' == 'true'">
    <IntermediateOutputPath>obj/$(Configuration)/config-tests/</IntermediateOutputPath>
    <OutputPath>bin/$(Configuration)/config-tests/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ConfigE2E)' == 'true'">
    <IntermediateOutputPath>obj/$(Configuration)/config-e2e/</IntermediateOutputPath>
    <OutputPath>bin/$(Configuration)/config-e2e/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PortableJson.cs" />
    <Compile Include="ConfigBundleTests.cs" />
    <Compile Include="ConfigE2E.cs" />
    <Compile Include="../ConfigBundle.cs" Link="ConfigBundle.cs" />
    <Compile Include="../SecretVault.cs" Link="SecretVault.cs" />
    <Compile Include="../SecretPrompt.cs" Link="SecretPrompt.cs" />
    <Compile Include="../SecretCommand.cs" Link="SecretCommand.cs" />
    <Compile Include="DiskTreeTests.cs" />
    <Compile Include="ConfigApplyTests.cs" />
    <Compile Include="../ConfigApply.cs" Link="ConfigApply.cs" />
    <Compile Include="ProxyRelayTests.cs" />
    <Compile Include="../ProxyRelay.cs" Link="ProxyRelay.cs" />
    <Compile Include="../UpgradeInstaller.cs" Link="UpgradeInstaller.cs" />
    <Compile Include="../StatusView.cs" Link="StatusView.cs" />
    <Compile Include="../Data.cs" Link="Data.cs" />
    <Compile Include="../UpdateEngine.cs" Link="UpdateEngine.cs" />
    <Compile Include="../UpdateSelfTests.cs" Link="UpdateSelfTests.cs" />
    <Compile Include="../SshUpdate.cs" Link="SshUpdate.cs" />
    <Compile Include="../NativeJob.cs" Link="NativeJob.cs" />
    <Compile Include="../WizardStep.cs" Link="WizardStep.cs" />
    <Compile Include="../DiskTreeSelection.cs" Link="DiskTreeSelection.cs" />
    <Compile Include="../ServerOperations.cs" Link="ServerOperations.cs" />
  </ItemGroup>
</Project>
