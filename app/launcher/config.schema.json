{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteAgents launcher configuration",
  "type": "object",
  "required": [
    "schema",
    "version",
    "components",
    "update"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "update": {
      "type": "object",
      "properties": {
        "sshExe": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remoteDir": {
          "type": "string"
        },
        "viaLocalPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hostKeyAlias": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Разрешить только ручную проверку обновлений на сервере"
        }
      },
      "additionalProperties": true
    },
    "happier": {
      "type": "object",
      "properties": {
        "serverUrl": {
          "type": "string",
          "format": "uri"
        },
        "webappUrl": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "additionalProperties": false
    },
    "bridge": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "allowShell": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "wizard": {
      "type": "object",
      "properties": {
        "configured": {
          "type": "boolean",
          "description": "UI intent only; never a health check"
        },
        "localCatalog": {
          "type": "object",
          "description": "Public per-device overlay; credentials remain in secrets"
        },
        "skipDisk": {
          "type": "boolean"
        },
        "skipHappier": {
          "type": "boolean"
        },
        "diskKeepPrevious": {
          "type": "boolean"
        },
        "diskPreviousProfile": {
          "type": "string",
          "description": "Previous SSH profile retained until an explicit Disk decision"
        },
        "skipLan": {
          "type": "boolean"
        },
        "serverRoute": {
          "type": "object",
          "description": "Last working way to reach the server in the wizard (non-secret): used, proxy{type,host,port}, hop{name,ssh,hostKey,keyFile}"
        },
        "pendingProfile": {
          "type": "string",
          "description": "Chosen server; active transport is kept until successful network preflight"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
