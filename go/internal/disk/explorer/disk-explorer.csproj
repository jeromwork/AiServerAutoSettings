<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <StartupObject>RemoteAgents.Lab.Entry</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>disk-explorer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <EmbeddedResource Include="app.ico" LogicalName="RemoteAgents.App.ico" />
    <EmbeddedResource Include="icons/*.ico" LogicalName="RemoteAgents.Icons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="stignore.txt" LogicalName="RemoteAgents.Lab.stignore.txt" />
  </ItemGroup>
</Project>
