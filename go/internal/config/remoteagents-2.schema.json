{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "remoteagents-2, v2config.py; VPN-only extension",
  "type": "object",
  "required": ["format", "name"],
  "properties": {
    "format": {"const": "remoteagents-2"},
    "name": {"type": "string", "pattern": "\\S"},
    "server": {
      "type": "object", "required": ["host", "user", "hostKey", "key"],
      "properties": {
        "host": {"type": "string", "pattern": "\\S"},
        "user": {"type": "string", "pattern": "\\S"},
        "hostKey": {"type": "string", "pattern": "\\S"},
        "key": {"type": "string", "pattern": "\\S"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "paths": {
      "type": "object",
      "properties": {
        "entries": {"type": "array", "items": {"anyOf": [
          {"$ref": "#/$defs/name"},
          {"type": "object", "required": ["name"], "properties": {"name": {"$ref": "#/$defs/name"}}}
        ]}},
        "secrets": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}}
      }
    },
    "vpn": {"type": "object", "properties": {"mode": {"enum": ["off", "auto", "only"]}}},
    "kdf": {"type": "object", "required": ["iterations"], "properties": {
      "iterations": {"type": "integer", "minimum": 1, "maximum": 5000000}
    }}
  },
  "anyOf": [
    {"required": ["server", "paths"]},
    {"required": ["vpn"], "not": {"anyOf": [{"required": ["server"]}, {"required": ["paths"]}]}}
  ],
  "$defs": {"name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$"}},
  "$comment": "Parse enforces v2 nonempty entries or channel; Open checks the password and enc1 secrets. Unknown fields are preserved."
}
