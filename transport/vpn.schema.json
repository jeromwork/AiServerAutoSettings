{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Схема config.json.vpn (соседняя секция с transport).",
  "title": "RemoteAgents VPN",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "excludeCidrs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "pattern": "^.+/[0-9]{1,3}$"
      }
    },
    "interfaceName": {
      "type": "string",
      "default": "RemoteAgents-TUN",
      "pattern": "^RemoteAgents-[a-zA-Z0-9_-]{1,32}$"
    },
    "address": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "default": [
        "172.31.255.1/30",
        "fdfe:7261::1/126"
      ]
    },
    "probeAddress": {
      "type": "string",
      "format": "ipv4",
      "default": "198.18.0.1"
    },
    "checkUrl": {
      "type": "string",
      "pattern": "^https://",
      "default": "https://example.com/"
    },
    "dnsServer": {
      "type": "string",
      "description": "IP DNS с поддержкой UDP и HTTPS /dns-query",
      "default": "1.1.1.1"
    },
    "bootstrapTag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
      "description": "Temporary catalog path checked by HTTPS before enrollment"
    }
  }
}
