{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Фрагмент: схема значения config.json.transport. Версия всего config.json задаётся лаунчером. Happier local web is read from config.profile.happier.localWeb (fallback config.happier.localWeb), not from transport. LAN settings live in config.profile.lan[].share (config.paste.schema.json): subnets, domains for split-DNS, dnsServers (up to four IPv4 inside that network), enabled (default true). Deprecated forwards are accepted and ignored. Get-TransportLan returns networks plus legacy merged fields.",
  "title": "RemoteAgents transport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profilePath": {
      "type": "string",
      "minLength": 1,
      "description": "Путь ssh-transport.json, созданного мастером (шаг «Сервер»)"
    },
    "channelPath": {
      "type": "string",
      "minLength": 1,
      "description": "Config.json канала, полученный мастером с сервера: VLESS и override_port входа sync"
    },
    "singBoxPath": {
      "type": "string",
      "minLength": 1,
      "description": "Путь sing-box 1.14.4; по умолчанию рядом с модулем"
    },
    "bindPhysical": {
      "type": "boolean",
      "default": true
    },
    "openSsh": {
      "type": "boolean",
      "default": true
    },
    "metered": {
      "enum": [
        "auto",
        "true",
        "false",
        true,
        false
      ],
      "default": "auto"
    },
    "sshPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 2222
    },
    "syncPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 22001
    },
    "probePortBase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 26000
    },
    "socksPortBase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 28000
    },
    "apiPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 29090
    },
    "stallSeconds": {
      "type": "integer",
      "minimum": 1,
      "default": 5
    },
    "probeTimeoutSec": {
      "type": "integer",
      "minimum": 1,
      "default": 45
    },
    "restartDelaySec": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "entries": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!-)[^\\r\\n]+$",
            "description": "Совместимость с задачей A; используйте ssh"
          },
          "configPath": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "ssh": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!-)[^\\r\\n]+$"
          },
          "kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "hy2",
                "hy2obfs",
                "tuic",
                "trojan",
                "reality",
                "shadowtls",
                "ws-direct",
                "ws-cdn"
              ]
            },
            "description": "Отсутствие или [] означает все доступные типы"
          }
        },
        "anyOf": [
          {
            "required": [
              "ssh"
            ]
          },
          {
            "required": [
              "alias"
            ]
          }
        ]
      }
    },
    "hops": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!-)[^\\r\\n]+$",
            "description": "Совместимость с задачей A; используйте ssh"
          },
          "configPath": {
            "type": "string",
            "minLength": 1
          },
          "hostKey": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Публичные OpenSSH host keys; не отпечатки SHA256"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "ssh": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!-)[^\\r\\n]+$"
          },
          "keyFile": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$",
            "description": "Локальный путь; в публичный каталог не передаётся"
          },
          "knownHostsPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$",
            "description": "Локальный путь; в публичный каталог не передаётся"
          }
        },
        "anyOf": [
          {
            "required": [
              "ssh"
            ]
          },
          {
            "required": [
              "alias"
            ]
          }
        ]
      }
    },
    "relays": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "port"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$"
          },
          "server": {
            "type": "string",
            "minLength": 1,
            "description": "Совместимость с задачей A; используйте host"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "host": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "host"
            ]
          },
          {
            "required": [
              "server"
            ]
          }
        ]
      }
    },
    "cdn": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "domain",
          "entry"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$"
          },
          "domain": {
            "type": "string",
            "pattern": "^(?=.{1,253}$)[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
          },
          "entry": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$"
          },
          "path": {
            "type": "string",
            "pattern": "^/[^\r\n]*$"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "disabledTags": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
      }
    },
    "serverRoute": {
      "description": "Личный overlay маршрута мастера; хранится только в локальном config.json",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "used": {
          "enum": [
            "direct",
            "hop",
            "proxy"
          ]
        },
        "hop": {
          "type": "object"
        },
        "proxy": {
          "type": "object"
        },
        "proxyExecutable": {
          "type": "string"
        }
      },
      "required": [
        "used"
      ],
      "additionalProperties": false
    },
    "bootstrap": {
      "type": "boolean",
      "description": "VPN-first from profile.vpn.bootstrap: HTTPS/TUN path before the first SSH; removed by the Connection step"
    },
    "cacheRoot": {
      "type": "string",
      "minLength": 1,
      "description": "Локальный каталог неизменяемого снимка кэшей после доверенного обновления"
    },
    "vpnInPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "default": 17881
    },
    "lanProxyPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "default": 17880
    },
    "switch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stallSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 8
        },
        "stallConns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 2
        }
      }
    },
    "priority": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Префиксы для первичного выбора из памяти и порядка отображения"
    },
    "activeProbeBytes": {
      "type": "integer",
      "minimum": 1,
      "default": 65536,
      "deprecated": true,
      "description": "не используется: переключение по событиям"
    },
    "rankProbeBytes": {
      "type": "integer",
      "minimum": 1,
      "default": 262144,
      "deprecated": true,
      "description": "не используется: переключение по событиям"
    },
    "activeIntervalSec": {
      "type": "integer",
      "minimum": 1,
      "default": 120,
      "deprecated": true,
      "description": "не используется: переключение по событиям"
    },
    "meteredActiveIntervalSec": {
      "type": "integer",
      "minimum": 1,
      "default": 300,
      "deprecated": true,
      "description": "не используется: переключение по событиям"
    },
    "allLivenessIntervalSec": {
      "type": "number",
      "minimum": 0,
      "deprecated": true,
      "description": "не используется: переключение по событиям"
    },
    "meteredAllLivenessIntervalSec": {
      "type": "number",
      "minimum": 0,
      "deprecated": true,
      "description": "не используется: переключение по событиям"
    },
    "rankIntervalSec": {
      "type": "integer",
      "minimum": 1,
      "default": 1800,
      "deprecated": true,
      "description": "не используется: переключение по событиям"
    },
    "topOnMetered": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "deprecated": true,
      "description": "не используется: переключение по событиям"
    },
    "rankConcurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 1,
      "description": "не используется: переключение по событиям",
      "deprecated": true
    },
    "switchFactor": {
      "type": "number",
      "minimum": 0,
      "deprecated": true,
      "description": "не используется: переключение по событиям"
    }
  },
  "$defs": {
    "localWeb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "serverPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "hint": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "port",
        "serverPort"
      ]
    }
  }
}
