client
proto tcp-client
remote vpn.example.invalid 1194
nobind
persist-key
persist-tun
dev tun
remote-cert-tls server
redirect-gateway def1
dhcp-option DNS 203.0.113.53
route 0.0.0.0 0.0.0.0
route 0.0.0.0 128.0.0.0
route 128.0.0.0 128.0.0.0
route 10.123.0.0 255.255.0.0
route-ipv6 ::/0
ifconfig-ipv6 2001:db8::1/64 2001:db8::2
pull-filter accept "redirect-gateway"
<ca>
TEST ONLY CA PLACEHOLDER
</ca>
<cert>
TEST ONLY CERT PLACEHOLDER
</cert>
<key>
TEST_ONLY_SECRET_NEVER_PRINT
</key>
<tls-crypt>
TEST_ONLY_TLS_SECRET_NEVER_PRINT
</tls-crypt>
