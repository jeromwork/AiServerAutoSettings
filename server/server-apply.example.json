{
  "kind": "remoteagents-config",
  "schema": 1,
  "hint": "Публичный пример сервера. Секреты задаёт владелец. Не запускать apply на живом сервере для проверки примера.",
  "server": {
    "address": "server.example.org",
    "login": "remoteagents"
  },
  "proxyOut": {
    "type": "socks",
    "server": "proxy.example.org",
    "port": 8017,
    "exitIp": "203.0.113.20",
    "password": {
      "secret": "proxy-out-password"
    },
    "checkUrl": "https://example.org/ip"
  },
  "lan": [
    {
      "name": "office",
      "kind": "openvpn",
      "ovpn": {
        "secret": "lan-office-ovpn",
        "hint": "Профиль OpenVPN со встроенными сертификатами и ключом"
      },
      "auth": {
        "secret": "lan-office-auth",
        "hint": "JSON с username и password от администратора сети"
      },
      "subnets": [
        "10.123.0.0/24"
      ],
      "directEndpoint": true,
      "host": "10.123.0.10",
      "port": 22,
      "checkUrl": "https://example.org/ip",
      "share": {
        "subnets": [
          "10.123.0.0/24"
        ],
        "domains": [
          "*.example.org"
        ],
        "dnsServers": [
          "10.123.0.53"
        ],
        "enabled": true
      }
    }
  ],
  "telegramGateway": {
    "enabled": true,
    "port": 8444
  },
  "agent": {
    "sudo": "full"
  }
}
