{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteAgents: настройки выдачи конфигов (remoteagents config export/sync)",
  "type": "object",
  "required": ["schema", "version", "serverAddress", "serverPort", "workerUser"],
  "additionalProperties": false,
  "$defs": {
    "path": { "type": "string", "pattern": "^/" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "host": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]{0,252}$" },
    "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
    "hostKey": { "type": "string", "pattern": "^(ssh-ed25519|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521|ssh-rsa) [A-Za-z0-9+/]+={0,2}$" }
  },
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "version": { "const": 1 },
    "serverAddress": { "$ref": "#/$defs/host", "description": "Адрес сервера, который получит компьютер" },
    "serverPort": { "$ref": "#/$defs/port", "description": "SSH-порт сервера" },
    "workerUser": { "allOf": [{ "$ref": "#/$defs/user" }, { "not": { "const": "root" } }], "description": "Рабочий пользователь; в его authorized_keys пишутся ключи выдачи" },
    "hostKeys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hostKey" }, "description": "Ключи хоста «тип base64»; если нет — читаются из hostKeyFiles" },
    "hostKeyFiles": { "type": "array", "items": { "$ref": "#/$defs/path" }, "description": "По умолчанию /etc/ssh/ssh_host_{ed25519,ecdsa,rsa}_key.pub" },
    "workerAuthorizedKeys": { "$ref": "#/$defs/path", "description": "По умолчанию ~рабочего/.ssh/authorized_keys" },
    "stateDir": { "$ref": "#/$defs/path", "description": "Записи выдач и журнал без секретов; по умолчанию /var/lib/remoteagents/config-export (root) или ~/.local/state/remoteagents/config-export" },
    "syncFile": { "$ref": "#/$defs/path", "description": "Снимок автообновления; по умолчанию ~рабочего/.config/remoteagents/config-sync.json" },
    "nodeCatalog": { "$ref": "#/$defs/path", "description": "Реестр моста; по умолчанию ~рабочего/.local/share/remote-agents-nodes" },
    "authLog": { "type": "array", "items": { "$ref": "#/$defs/path" }, "description": "Журналы sshd для «последнего входа»; по умолчанию journalctl (нужен root или группа adm/systemd-journal)" },
    "catalogFile": { "$ref": "#/$defs/path", "description": "Общий каталог связи; по умолчанию ~рабочего/.config/remoteagents/transport-catalog.json" },
    "routes": {
      "type": "array", "minItems": 1, "description": "Порядок маршрутов; по умолчанию только direct",
      "items": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "direct" } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "proxy"], "properties": {
            "kind": { "const": "proxy" },
            "proxy": { "type": "object", "additionalProperties": false, "required": ["type", "server", "port"], "properties": {
              "type": { "enum": ["socks", "http"] }, "server": { "$ref": "#/$defs/host" }, "port": { "$ref": "#/$defs/port" } } } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "hop"], "properties": {
            "kind": { "const": "hop" },
            "hop": { "type": "object", "additionalProperties": false, "required": ["host", "user", "hostKey"],
              "anyOf": [{ "required": ["keyFile"] }, { "required": ["passwordFile"] }],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
                "host": { "$ref": "#/$defs/host" }, "port": { "$ref": "#/$defs/port" }, "user": { "$ref": "#/$defs/user" },
                "hostKey": { "$ref": "#/$defs/hostKey" },
                "keyFile": { "$ref": "#/$defs/path", "description": "Закрытый ключ перехода, файл 0600" },
                "passwordFile": { "$ref": "#/$defs/path", "description": "Пароль перехода, файл 0600" } } } } }
        ]
      }
    },
    "vpnBootstrap": {
      "type": "object", "additionalProperties": false, "required": ["channelFile", "vpn"],
      "description": "VPN первым: снимки, которые компьютер получает в секретах конфига",
      "properties": {
        "channelFile": { "$ref": "#/$defs/path", "description": "JSON канала сервера, 0600" },
        "entryFiles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/path" }, "description": "имя узла каталога → client.json, 0600" },
        "hops": { "type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["host", "port", "user", "keyFile"],
          "properties": { "host": { "$ref": "#/$defs/host" }, "port": { "$ref": "#/$defs/port" }, "user": { "$ref": "#/$defs/user" }, "keyFile": { "$ref": "#/$defs/path" } } } },
        "vpn": { "type": "object", "additionalProperties": false, "required": ["checkUrl", "dnsServer"], "properties": {
          "checkUrl": { "type": "string", "pattern": "^https://" }, "dnsServer": { "type": "string" } } }
      }
    },
    "happier": { "type": "object", "additionalProperties": false, "properties": {
      "account": { "type": "string", "description": "Подпись аккаунта для --happier same" },
      "serverUrl": { "type": "string" }, "webappUrl": { "type": "string" } } }
  }
}
