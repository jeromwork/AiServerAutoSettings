@contextmanager
def locked(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a+') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        try:
            yield stream
        finally:
            fcntl.flock(stream, fcntl.LOCK_UN)


def append_json(path, value):
    with locked(path) as stream:
        stream.write(json.dumps(value, ensure_ascii=False) + '\n')
        stream.flush()
        os.fsync(stream.fileno())


def read_jsonl(path):
    if not path.exists():
        return []
    rows = []
    with locked(path) as stream:
        stream.seek(0)
        for number, line in enumerate(stream, 1):
            if not line.strip():
                continue
            try:
                value = json.loads(line)
                if not isinstance(value, dict):
                    raise ValueError('ожидался объект')
                rows.append(value)
            except ValueError as error:
                print(f'Предупреждение: {path}:{number}: {error}', file=sys.stderr)
    return rows


def git(directory, *args, binary=False, env=None):
    result = subprocess.run(['git', '-C', str(directory), *args], stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, timeout=120, env=env)
    if result.returncode:
        raise RuntimeError(result.stderr.decode(errors='replace').strip())
    return result.stdout if binary else result.stdout.decode(errors='surrogateescape').strip()


def tasks():
    found = {}
    for folder in sorted((KIT / 'tasks').iterdir()):
        if not folder.is_dir():
            continue
        meta = json.loads((folder / 'meta.json').read_text())
        task_id = meta['id']
        if not re.fullmatch(r'[0-9]{2}-[a-z0-9-]+', task_id) or task_id in found:
            raise ValueError(f'Неверный или повторный id: {task_id}')
        if not isinstance(meta['allowed_files'], list) or not meta['allowed_files']:
            raise ValueError(f'{task_id}: нужен непустой allowed_files')
        for name in meta['allowed_files']:
            if not isinstance(name, str) or Path(name).is_absolute() or '..' in Path(name).parts:
                raise ValueError(f'{task_id}: неверный allowed_files')
        for name in ('task.md', 'check.sh'):
            if not (folder / name).is_file():
                raise ValueError(f'{task_id}: нет {name}')
        found[task_id] = dict(meta, folder=folder)
    return found


def parse_logs(progress, raw='', returncode=0, timed_out=False):
    """Статус берём только из служебных строк, не из текста ответа модели."""
    endings = re.findall(r'^\[\d+:\d+\]\s+(ГОТОВО|ЗАВИС|ОШИБКА|ПРЕДЕЛ ВРЕМЕНИ)\b',
                         progress, flags=re.M)
    status = endings[-1] if endings else 'ОШИБКА'
    if status == 'ПРЕДЕЛ ВРЕМЕНИ' or timed_out or returncode in (2, 3):
        status = 'ЗАВИС'
    elif returncode and status == 'ГОТОВО':
        status = 'ОШИБКА'
    diagnostic = (progress + '\n' + raw).lower()
    error_kind = None
    # Не анализируем успешный ответ модели как ошибку, даже если он цитирует EOF.
    if status != 'ГОТОВО':
        if timed_out or 'print_timeout' in diagnostic or 'print-timeout' in diagnostic or 'предел времени' in diagnostic:
            error_kind = 'print_timeout'
        elif re.search(r'\b503\b|no capacity|capacity exhausted', diagnostic):
            error_kind = '503 no capacity'
        elif re.search(r'\beof\b|unexpected end of (file|input|stream)', diagnostic):
            error_kind = 'EOF'
        elif re.search(r'interrupt|cancelled|canceled|sigint|keyboardinterrupt', diagnostic) or returncode in (-2, 130):
            error_kind = 'interrupted'
        else:
            error_kind = 'прочее'
    tokens = {}

    def collect(value, prefix=''):
        if isinstance(value, dict):
            for key, item in value.items():
                path = f'{prefix}.{key}' if prefix else key
                if 'token' in key.lower() and isinstance(item, (int, float)) and not isinstance(item, bool):
                    tokens[path] = item
                elif isinstance(item, (dict, list)):
                    collect(item, path)
        elif isinstance(value, list):
            for item in value:
                collect(item, prefix)

    for line in raw.splitlines():
        try:
            collect(json.loads(line))
        except ValueError:
            pass
    return dict(status=status, error_kind=error_kind,
                turns=len(re.findall(r'^\[\d+:\d+\]\s+→', progress, re.M)),
                tokens=tokens or None)


def change_stats(directory, base, allowed_files):
    """Сравнение с исходным commit включает staged, unstaged и коммиты агента."""
    changed = {}
    data = git(directory, 'diff', '--numstat', '-z', '--no-renames', base, '--', binary=True)
    for item in data.split(b'\0'):
        if item:
            added, removed, name = item.split(b'\t', 2)
            changed[os.fsdecode(name)] = (int(added) if added.isdigit() else 0,
                                         int(removed) if removed.isdigit() else 0)
    for item in git(directory, 'ls-files', '--others', '--exclude-standard', '-z', binary=True).split(b'\0'):
        if not item:
            continue
        name = os.fsdecode(item)
        path = directory / name
        # Не переходить по symlink за пределы worktree.
        content = os.fsencode(os.readlink(path)) if path.is_symlink() else path.read_bytes()
        count = 0 if b'\0' in content else len(content.splitlines())
        changed[name] = (count, 0)
    return dict(files_changed=len(changed), lines_added=sum(v[0] for v in changed.values()),
                lines_removed=sum(v[1] for v in changed.values()),
                forbidden_files=sorted(set(changed) - set(allowed_files)))


def artifact_dir(row):
    root = home() / 'runs' / row['runid'] / f'{row["task"]}-{row["mode"]}-{row["repeat"]}'
    return root if row.get('round', 1) == 1 else root / f'round-{row["round"]}'


def limit(name, default):
    value = int(os.environ.get(name, default))
    if value < 0:
        raise ValueError(f'{name}: лимит должен быть >= 0')
    return value


def write_meta(folder, meta):
    temporary = folder / 'meta.json.tmp'
    temporary.write_text(json.dumps(meta, ensure_ascii=False, indent=2) + '\n')
    temporary.replace(folder / 'meta.json')


def save_patch(directory, base, folder, row):
    """Отдельный индекс: ни index worktree, ни индекс основного дерева не меняются."""
    with tempfile.TemporaryDirectory(prefix='gbench-index-') as temp:
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(temp) / 'index'))
        git(directory, 'read-tree', 'HEAD', env=env)
        git(directory, 'add', '-N', '--all', '--', env=env)
        temporary = folder / 'patch.diff.tmp'
        try:
            with temporary.open('wb') as output:
                result = subprocess.run(['git', '-C', str(directory), 'diff', '--binary',
                                         '--no-ext-diff', '--no-textconv', '--no-renames', base, '--'],
                                        env=env, stdout=output, stderr=subprocess.PIPE, timeout=120)
            if result.returncode:
                raise RuntimeError(result.stderr.decode(errors='replace'))
            digest = hashlib.sha256()
            with temporary.open('rb') as stream:
                for chunk in iter(lambda: stream.read(65536), b''):
                    digest.update(chunk)
            size = temporary.stat().st_size
            dropped = size > limit('GEMINI_BENCH_PATCH_MAX_BYTES', PATCH_MAX_BYTES)
            meta = {key: row[key] for key in ('runid', 'task', 'mode', 'repeat', 'round', 'ts', 'base_commit')}
            meta.update(patch_bytes=size, patch_sha256=digest.hexdigest(), patch_dropped=dropped,
                        patch_drop_reason='size_limit' if dropped else None)
            if not dropped:
                temporary.replace(folder / 'patch.diff')
            else:
                (folder / 'patch.diff').unlink(missing_ok=True)
            write_meta(folder, meta)
        finally:
            temporary.unlink(missing_ok=True)


def round_key(row):
    return (row['runid'], row['task'], row['mode'], row.get('repeat', 1), row.get('round', 1))


def verdict_for(row, verdicts):
    # Старые записи без repeat относились ко всем повторам, но только к кругу 1.
    key = round_key(row)
    matches = [v for v in (verdicts.get(key), verdicts.get((*key[:3], None, key[4]))) if v]
    return max(matches, key=lambda v: v.get('_order', 0)) if matches else None


def verdict_map():
    latest = {}
    for order, row in enumerate(read_jsonl(home() / 'verdicts.jsonl')):
        row = dict(row, _order=order)
        key = (row['runid'], row['task'], row['mode'], row.get('repeat'), row.get('round', 1))
        latest[key] = row
    return latest


def prune_patches():
    """Лимит мягкий: замечания/отказы/непроверенное не удаляем даже при превышении."""
    root = home() / 'runs'
    if not root.exists():
        return
    maximum = limit('GEMINI_BENCH_RUNS_MAX_BYTES', RUNS_MAX_BYTES)
    with locked(home() / 'artifacts.lock'):
        total = sum(p.stat().st_size for p in root.rglob('*') if p.is_file())
        if total <= maximum:
            return
        verdicts = verdict_map()
        history = read_jsonl(home() / 'verdicts.jsonl')
        candidates = []
        for path in root.rglob('meta.json'):
            meta = json.loads(path.read_text())
            patch = path.parent / 'patch.diff'
            verdict = verdict_for(meta, verdicts)
            # Сохранить и ранее отмеченные замечания этого круга, даже если оценку исправили.
            challenged = any(v['runid'] == meta['runid'] and v['task'] == meta['task']
                             and v['mode'] == meta['mode'] and v.get('repeat') in (None, meta['repeat'])
                             and v.get('round', 1) == meta['round'] and v['verdict'] != 'ПРИНЯТО'
                             for v in history)
            if patch.is_file() and verdict and verdict['verdict'] == 'ПРИНЯТО' and not challenged:
                candidates.append((meta['ts'], path, meta))
        for _, path, meta in sorted(candidates, key=lambda item: (item[0], str(item[1]))):
            if total <= maximum:
                break
            patch = path.parent / 'patch.diff'
            size = patch.stat().st_size
            previous = path.stat().st_size
            meta.update(patch_dropped=True, patch_drop_reason='runs_limit',
                        patch_pruned_ts=datetime.now().astimezone().isoformat())
            write_meta(path.parent, meta)
            patch.unlink()
            total += path.stat().st_size - previous - size
        if total > maximum:
            print(f'Предупреждение: runs занимает {total} байт при лимите {maximum}; '
                  'защищённые артефакты сохранены.', file=sys.stderr)


def save_artifacts(directory, base, folder, row, progress_text):
    (folder / 'gemini.progress').write_text(progress_text)
    answer = progress_text.split('===== ОТВЕТ GEMINI =====', 1)
    report_text = answer[1] if len(answer) == 2 else progress_text
    # Обёртка дописывает служебный финальный статус после ответа.
    report_text = re.sub(r'^\[\d+:\d+\].*$', '', report_text, flags=re.M).strip()
    (folder / 'report.txt').write_text(report_text + '\n')
    (folder / 'check.txt').write_text(row['check_detail'])
    with locked(home() / 'artifacts.lock'):
        save_patch(directory, base, folder, row)
    row['artifact_dir'] = str(folder)
    row['progress_file'] = str(folder / 'gemini.progress')


def descendants(pid):
    """agy создаёт собственную сессию: одного killpg обёртки недостаточно (Linux)."""
    children = defaultdict(list)
    for path in Path('/proc').glob('[0-9]*/stat'):
        try:
            fields = path.read_text().rsplit(')', 1)[1].split()
            children[int(fields[1])].append(int(path.parent.name))
        except (OSError, ValueError, IndexError):
            pass
    found = []

    def visit(parent):
        for child in children[parent]:
            visit(child)
            found.append(child)
    visit(pid)
    return found


def stop_process(proc):
    pids = descendants(proc.pid)
    # Заморозить дерево перед убийством, чтобы обёртка не создала ещё один процесс.
    for pid in [proc.pid, *pids]:
        try:
            os.kill(pid, signal.SIGSTOP)
        except ProcessLookupError:
            pass
    for pid in [*pids, proc.pid]:
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    proc.wait(timeout=10)


def execute(command, cwd, output, seconds, env=None):
    with output.open('w') as stream:
        proc = subprocess.Popen(command, cwd=cwd, stdin=subprocess.DEVNULL, stdout=stream,
                                stderr=subprocess.STDOUT, start_new_session=True, env=env)
        try:
            return proc.wait(timeout=seconds), False
        except subprocess.TimeoutExpired:
            stop_process(proc)
            return proc.returncode, True
        except BaseException:
            stop_process(proc)
            raise


def run_one(args, task, mode, repeat, runid, base, work_root, git_lock,
            round_number=1, previous=None, conversation=None, feedback=None):
    name = f'{runid}-{task["id"]}-{mode}-{repeat}'
    if round_number > 1:
        name += f'-r{round_number}'
    directory = work_root / f'wt-gb-{name}'
    branch = f'gb/{name}'
    now = datetime.now().astimezone()
    row = dict(runid=runid, ts=now.isoformat(), weekday=now.weekday(), hour=now.hour,
               task=task['id'], mode=mode, repeat=repeat, round=round_number, label=args.label,
               status='ОШИБКА', error_kind='прочее', seconds=0, turns=0, tokens=None,
               check_ok=False, check_detail='', files_changed=0, lines_added=0, lines_removed=0,
               forbidden_files=[], worktree=str(directory), progress_file=None,
               base_commit=base, branch=branch, retained=False, allowed_files=task['allowed_files'])
    artifacts = artifact_dir(row)
    artifacts.mkdir(parents=True, exist_ok=False)
    plan = artifacts / 'task.md'
    row['plan_file'] = str(plan)
    started = time.monotonic()
    created = saved = False
    progress_text = ''
    try:
        if previous:
            original = Path(previous['plan_file']).read_text().replace(previous['worktree'], str(directory))
            plan.write_text(original + '\n\nИсправь по замечаниям ревьюера. Сейчас круг ' + str(round_number)
                            + '. Работай только в ' + str(directory) + '.\n'
                            + 'Тесты не запускать: их один раз запустит набор после отчёта.\n'
                            + json.dumps(feedback, ensure_ascii=False, indent=2) + '\n')
            check_source = artifact_dir(previous) / 'check.sh'
        else:
            plan.write_text((task['folder'] / 'task.md').read_text().replace('WORKDIR', str(directory)))
            check_source = task['folder'] / 'check.sh'
        check = artifacts / 'check.sh'
        check.write_bytes(check_source.read_bytes())
        row['plan_file'] = str(plan)
        with locked(git_lock):
            git(repo(), 'worktree', 'add', '-b', branch, str(directory), base)
            created = True
        if previous:
            source = artifact_dir(previous)
            meta = json.loads((source / 'meta.json').read_text())
            data = (source / 'patch.diff').read_bytes()
            if hashlib.sha256(data).hexdigest() != meta['patch_sha256']:
                raise ValueError('Хеш сохранённого patch.diff не совпадает; продолжение остановлено')
            if data:
                git(directory, 'apply', '--binary', str(source / 'patch.diff'))
        start = time.monotonic()
        output = artifacts / 'runner.log'
        command = [os.environ.get('GEMINI_TASK_BIN', 'gemini-task'),
                   '-C', str(directory), '-f', str(plan),
                   '--model', f'gemini-3.8-flash-{mode}', '--name', name,
                   '--max-min', str(args.max_min)]
        if conversation:
            command += ['--continue', conversation]
        code, timed_out = execute(command, directory, output, args.max_min * 60)
        row['seconds'] = round(time.monotonic() - start, 3)
        console = output.read_text(errors='replace')
        journals = re.findall(r'^\[\d+:\d+\]\s+журнал:\s*(.+\.progress)\s*$', console, re.M)
        progress = Path(journals[-1]).expanduser() if journals else output
        row['source_progress_file'] = str(progress)
        progress_text = progress.read_text(errors='replace') if progress.is_file() else console
        raw_path = progress.with_suffix('.jsonl')
        raw = raw_path.read_text(errors='replace') if raw_path.is_file() else ''
        row.update(parse_logs(progress_text, raw, code, timed_out))
        code, expired = execute(['bash', str(check)], directory, artifacts / 'check.txt', 120)
        row['check_detail'] = (artifacts / 'check.txt').read_text(errors='replace')
        if expired:
            row['check_detail'] += '\nПриёмка превысила 120 секунд.'
        row['check_ok'] = code == 0 and not expired
        row.update(change_stats(directory, base, task['allowed_files']))
        if row['forbidden_files']:
            row['check_ok'] = False
            row['check_detail'] += '\nЗапрещённые файлы: ' + ', '.join(row['forbidden_files'])
    except Exception as error:
        row['status'], row['error_kind'], row['check_ok'] = 'ОШИБКА', 'прочее', False
        row['check_detail'] += f'\nОшибка набора: {type(error).__name__}: {error}'
        if not row['seconds']:
            row['seconds'] = round(time.monotonic() - started, 3)
    finally:
        if created:
            try:
                save_artifacts(directory, base, artifacts, row, progress_text)
                saved = True
            except Exception as error:
                row['artifact_error'] = str(error)
                row['check_ok'] = False
                row['check_detail'] += f'\nОшибка сохранения артефактов: {error}'
        else:
            (artifacts / 'check.txt').write_text(row['check_detail'])
        failed = row['status'] != 'ГОТОВО' or not row['check_ok']
        row['retained'] = created and (not saved or args.keep_all or (args.keep_failed and failed))
        if created and not row['retained']:
            try:
                with locked(git_lock):
                    git(repo(), 'worktree', 'remove', '--force', str(directory))
                    git(repo(), 'branch', '-D', branch)
            except Exception as error:
                row['retained'] = directory.exists()
                row['cleanup_error'] = str(error)
                row['check_detail'] += f'\nОшибка очистки: {error}'
        (artifacts / 'check.txt').write_text(row['check_detail'])
        append_json(home() / 'results.jsonl', row)
        prune_patches()
    return row


def run_context():
    limit('GEMINI_BENCH_PATCH_MAX_BYTES', PATCH_MAX_BYTES)
    limit('GEMINI_BENCH_RUNS_MAX_BYTES', RUNS_MAX_BYTES)
    base = git(repo(), 'rev-parse', '--verify', 'main^{commit}')
    common = Path(git(repo(), 'rev-parse', '--git-common-dir'))
    if not common.is_absolute():
        common = repo() / common
    git_lock = common.resolve() / 'gemini-bench-worktree.lock'
    work_root = home() / 'worktrees' if 'GEMINI_BENCH_HOME' in os.environ else Path.home() / 'work'
    work_root.mkdir(parents=True, exist_ok=True)
    return base, work_root, git_lock


def selected_rows(args):
    rows = [r for r in read_jsonl(home() / 'results.jsonl')
            if (r['runid'], r['task'], r['mode']) == (args.runid, args.task, args.mode)
            and (args.repeat is None or r['repeat'] == args.repeat)]
    if not rows:
        raise ValueError('Такой тройки runid/task/mode (и повтора) нет в results.jsonl')
    return rows


def retry(args):
    # Блокировка предотвращает два одновременных продолжения одного круга.
    with locked(home() / 'retry.lock'):
        rows = selected_rows(args)
        if len({r['repeat'] for r in rows}) != 1:
            raise ValueError('Несколько повторов: выберите один через --repeat N')
        previous = max(rows, key=lambda r: r.get('round', 1))
        verdict = verdict_for(previous, verdict_map())
        if not verdict or verdict['verdict'] != 'ЗАМЕЧАНИЯ':
            raise ValueError('retry требует вердикт ЗАМЕЧАНИЯ для последнего круга')
        source = artifact_dir(previous)
        if not (source / 'meta.json').is_file():
            raise ValueError('Нет сохранённых артефактов; нужен новый run')
        meta = json.loads((source / 'meta.json').read_text())
        if meta.get('patch_dropped') or not (source / 'patch.diff').is_file():
            raise ValueError('patch.diff не сохранён (patch_dropped или удалён по лимиту); retry невозможен')
        progress = (source / 'gemini.progress').read_text()
        ids = re.findall(r'^\[\d+:\d+\].*продолжить:.*--continue\s+([A-Za-z0-9_-]+)', progress, re.M)
        if not ids or ids[-1] in ('None', 'null'):
            raise ValueError('В сохранённом .progress нет conversation id для --continue')
        if not any(str(verdict.get(k, '')).strip() for k in ('blockers', 'minor', 'note', 'text')):
            raise ValueError('У последнего вердикта нет замечаний: сначала запишите причину')
        # Снимок check.sh и allowed_files берём из предыдущего круга.
        task = dict(id=args.task, allowed_files=previous.get('allowed_files') or tasks()[args.task]['allowed_files'])
        args.label = previous['label']
        base, work_root, git_lock = run_context()
        row = run_one(args, task, args.mode, previous['repeat'], args.runid, base, work_root,
                      git_lock, previous.get('round', 1) + 1, previous, ids[-1],
                      {k: v for k, v in verdict.items() if not k.startswith('_')})
        print(f'Круг {row["round"]}: {row["status"]}; механика={row["check_ok"]}; {artifact_dir(row)}')
        return 1 if row['status'] != 'ГОТОВО' or not row['check_ok'] or row.get('cleanup_error') else 0


def run(args):
    available = tasks()
    selected = list(available) if args.tasks == 'all' else args.tasks.split(',')
    modes = args.modes.split(',')
    if not selected or len(set(selected)) != len(selected) or set(selected) - available.keys():
        raise ValueError('Неизвестные или повторные задачи; см. list')
    if not modes or len(set(modes)) != len(modes) or set(modes) - set(MODES):
        raise ValueError('Режимы: low,medium,high (без повторов)')
    base, work_root, git_lock = run_context()
    runid = datetime.now().strftime('%Y%m%d-%H%M%S-') + uuid.uuid4().hex[:8]
    print(f'Прогон {runid}; main={base}; параллельность={args.parallel}', flush=True)
    combinations = itertools.product(selected, modes, range(1, args.repeat + 1))
    failed = False
    with ThreadPoolExecutor(max_workers=args.parallel) as pool:
        futures = [pool.submit(run_one, args, available[t], m, n, runid, base, work_root, git_lock)
                   for t, m, n in combinations]
        for future in as_completed(futures):
            row = future.result()
            failed |= row['status'] != 'ГОТОВО' or not row['check_ok'] or bool(row.get('cleanup_error'))
            print(f'{row["task"]} {row["mode"]} #{row["repeat"]}: {row["status"]}; '
                  f'механика={"да" if row["check_ok"] else "нет"}; {row["seconds"]:.1f} с', flush=True)
    print(f'Результаты: {home() / "results.jsonl"}', flush=True)
    return 1 if failed else 0


def cell(value):
    return str(value).replace('|', '\\|').replace('\n', ' ')


def table(headers, rows):
    return '\n'.join(['| ' + ' | '.join(map(cell, headers)) + ' |',
                      '| ' + ' | '.join('---' for _ in headers) + ' |',
                      *['| ' + ' | '.join(map(cell, row)) + ' |' for row in rows]])


def summarize(rows, verdicts):
    reviewed = [(verdict_for(r, verdicts) or {}).get('verdict') for r in rows]
    errors = Counter(r['error_kind'] for r in rows if r.get('error_kind'))
    return [f'{sum(bool(r["check_ok"]) for r in rows)}/{len(rows)}',
            f'{reviewed.count("ПРИНЯТО")}/{sum(v is not None for v in reviewed)}',
            round(statistics.median(r['seconds'] for r in rows), 1),
            ', '.join(f'{k}: {v}' for k, v in sorted(errors.items())) or '—']


def report(args):
    rows = read_jsonl(home() / 'results.jsonl')
    if args.since:
        since = datetime.fromisoformat(args.since)
        # Дата без зоны — в местной зоне, как ts при запуске.
        since = since.astimezone()
        rows = [r for r in rows if datetime.fromisoformat(r['ts']).astimezone() >= since]
    if args.label is not None:
        rows = [r for r in rows if r['label'] == args.label]
    if not rows:
        print('Нет результатов для выбранного фильтра.')
        return 0
    verdicts = verdict_map()
    print('Механика: check.sh + разрешённые файлы. Ревью: ПРИНЯТО / с вердиктом; 0/0 = ревью нет.\n'
          'Оценки привязаны к повтору и кругу; старые записи без repeat — ко всем повторам круга 1.\n'
          'Время — только gemini-task, без создания worktree и приёмки. Часы — местное время запуска.\n')
    for title, key, headers in (
        ('Задача × режим', lambda r: (r['task'], r['mode']), ['Задача', 'Режим']),
        ('Итог по режимам', lambda r: (r['mode'],), ['Режим']),
        ('По часу суток и режиму', lambda r: (f'{r["hour"]:02d}:00', r['mode']), ['Час', 'Режим']),
        ('По дню недели и режиму', lambda r: (r['weekday'], r['mode']), ['День', 'Режим']),
    ):
        groups = defaultdict(list)
        for row in rows:
            groups[key(row)].append(row)
        output = []
        for group, items in sorted(groups.items()):
            labels = list(group)
            if headers[0] == 'День':
                labels[0] = DAYS[labels[0]]
            output.append(labels + summarize(items, verdicts))
        print(title + '\n\n' + table(headers + ['Механика', 'Ревью', 'Медиана, с', 'Ошибки'], output) + '\n')
    quality_report(rows, verdicts)
    slow = [r for r in rows if r['seconds'] > 300]
    print('Запуски дольше 5 минут\n')
    print(table(['runid', 'Задача', 'Режим', 'Повтор', 'Секунды', 'Статус', 'Круг'],
                [[r['runid'], r['task'], r['mode'], r['repeat'], r['seconds'], r['status'], r.get('round', 1)]
                 for r in sorted(slow, key=lambda r: r['seconds'], reverse=True)]) if slow else 'Нет.')
    return 0


def quality_report(rows, verdicts):
    chains = defaultdict(list)
    for row in rows:
        chains[round_key(row)[:4]].append(row)
    outcomes = []
    for attempts in chains.values():
        final = max(attempts, key=lambda r: r.get('round', 1))
        verdict = verdict_for(final, verdicts)
        rounds = max(r.get('round', 1) for r in attempts)
        if verdict and verdict['verdict'] == 'ПРИНЯТО':
            outcome = 'first' if rounds == 1 else 'fixed'
        elif verdict and verdict['verdict'] == 'ОТВЕРГНУТО':
            outcome = 'rejected'
        elif final['status'] != 'ГОТОВО' or not final['check_ok']:
            outcome = 'mechanics'
        else:
            outcome = 'pending'
        outcomes.append((final, outcome, rounds))
    for title, by_task in (('Итоги ревью по задачам и режимам', True), ('Итоги ревью по режимам', False)):
        groups = defaultdict(list)
        for final, outcome, rounds in outcomes:
            key = (final['task'], final['mode']) if by_task else (final['mode'],)
            groups[key].append((outcome, rounds))
        output = []
        for key, items in sorted(groups.items()):
            counts = Counter(outcome for outcome, _ in items)
            output.append([*key, *[counts[k] for k in ('first', 'fixed', 'rejected', 'mechanics', 'pending')],
                           round(statistics.mean(n for _, n in items), 2)])
        print(title + '\n\n' + table((['Задача', 'Режим'] if by_task else ['Режим']) +
              ['Принято с 1-го круга', 'После правок', 'Отвергнуто', 'Не прошёл механику',
               'Ожидает ревью/правок', 'Среднее число кругов'], output) + '\n')
    reasons = Counter()
    mismatches = defaultdict(set)
    seen = set()
    for row in rows:
        verdict = verdict_for(row, verdicts)
        if not verdict or verdict['verdict'] == 'ПРИНЯТО':
            continue
        # Несколько старых строк результата одного круга не удваивают причину.
        key = round_key(row)
        if key not in seen:
            seen.add(key)
            reason = verdict.get('tag') or ' '.join((verdict.get('blockers') or verdict.get('note')
                                                    or verdict.get('text') or verdict.get('minor')
                                                    or 'причина не записана').lower().split()[:4])
            reasons[reason] += 1
        if row['check_ok']:
            mismatches[row['mode']].add(row['task'])
    print('Топ причин отказа / замечаний (последняя оценка каждого круга)\n\n' +
          table(['Причина / тег', 'Число'], reasons.most_common(10)) + '\n')
    print('Ложная уверенность: механика ок, ревью ЗАМЕЧАНИЯ/ОТВЕРГНУТО хотя бы в одном круге.\n'
          'Число различных задач в выбранных прогонах, а не число повторов.\n\n' +
          table(['Режим', 'Число задач с расхождением'],
                [[mode, len(mismatches[mode])] for mode in sorted({r['mode'] for r in rows})]) + '\n')


def review(args):
