                '', 'При замечаниях: retry, затем снова review и add-verdict следующего круга.',
                'Этот файл ничего не запускает.', '']
    path = home() / f'review-{args.runid}.md'
    path.write_text('\n'.join(content))
    print(path)
    return 0


def text_or_file(value):
    return Path(value[1:]).expanduser().read_text() if value.startswith('@') else value


def add_verdict(args):
    rows = selected_rows(args)
    legacy = args.legacy_verdict is not None
    if legacy:
        if args.verdict or args.round is not None or args.reviewer:
            raise ValueError('Не смешивайте короткий формат с --verdict/--round/--reviewer')
        verdict, round_number, reviewer = args.legacy_verdict, 1, 'human'
    else:
        if not args.verdict or args.round is None or not args.reviewer:
            raise ValueError('Нужны --round N --reviewer codex|opus|human --verdict ВЕРДИКТ')
        verdict, round_number, reviewer = args.verdict, args.round, args.reviewer
    selected = [r for r in rows if r.get('round', 1) == round_number]
    if not selected:
        raise ValueError('Такого круга нет в results.jsonl')
    blockers, minor = text_or_file(args.blockers), text_or_file(args.minor)
    note = args.note or args.text
    if not legacy and args.text:
        raise ValueError('В новом формате используйте --note вместо позиционного текста')
    if verdict != 'ПРИНЯТО' and not any(t.strip() for t in (blockers, minor, note)):
        raise ValueError('Причина отказа/замечаний обязательна: --blockers, --minor или --note')
    for repeat in sorted({r['repeat'] for r in selected}):
        append_json(home() / 'verdicts.jsonl', dict(ts=datetime.now().astimezone().isoformat(),
                    runid=args.runid, task=args.task, mode=args.mode, repeat=repeat,
                    round=round_number, reviewer=reviewer, verdict=verdict, blockers=blockers,
                    minor=minor, note=note, tag=args.tag))
    prune_patches()
    print(f'Вердикт записан: круг {round_number}; история сохранена.')
    return 0


def show(args):
    rows = selected_rows(args)
    history = read_jsonl(home() / 'verdicts.jsonl')
    for row in sorted(rows, key=lambda r: (r['repeat'], r.get('round', 1))):
        folder = artifact_dir(row)
        print(f'\n{row["task"]} / {row["mode"]} / повтор {row["repeat"]} / круг {row.get("round", 1)}')
        path = folder / 'report.txt'
        print(path.read_text() if path.is_file() else 'Отчёт Gemini отсутствует (старый или незавершённый прогон).')
        print(f'patch.diff: {folder / "patch.diff"}')
        if (folder / 'meta.json').is_file():
            meta = json.loads((folder / 'meta.json').read_text())
            if meta.get('patch_dropped'):
                print(f'Патч отброшен: {meta.get("patch_drop_reason")}; '
                      f'{meta["patch_bytes"]} байт; sha256={meta["patch_sha256"]}')
        for verdict in history:
            if (verdict['runid'], verdict['task'], verdict['mode']) != (args.runid, args.task, args.mode):
                continue
            if verdict.get('repeat') not in (None, row['repeat']) or verdict.get('round', 1) != row.get('round', 1):
                continue
            print(f'Ревью: круг {verdict.get("round", 1)}, {verdict.get("reviewer", "human")}, '
                  f'{verdict["verdict"]} ({verdict["ts"]})')
            print('Блокеры: ' + verdict.get('blockers', ''))
            print('Мелочи: ' + verdict.get('minor', ''))
            print('Итог/причина: ' + (verdict.get('note') or verdict.get('text', '')))
            if verdict.get('tag'):
                print('Тег: ' + verdict['tag'])
    verdicts = verdict_map()
    for repeat in sorted({r['repeat'] for r in rows}):
        last = max((r for r in rows if r['repeat'] == repeat), key=lambda r: r.get('round', 1))
        final = verdict_for(last, verdicts)
        state = final['verdict'] if final else 'Ожидает ревью'
        if state == 'ЗАМЕЧАНИЯ':
            state += ' (финал пока не записан)'
        print(f'Финал повтора {repeat}: {state}')
    return 0


def positive(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError('Нужно целое число > 0')
    return number


def minutes(value):
    number = float(value)
    if not math.isfinite(number) or number <= 0:
        raise argparse.ArgumentTypeError('Нужно конечное число минут > 0')
    # gemini-task принимает целые минуты.
    if not number.is_integer():
        raise argparse.ArgumentTypeError('Нужно целое число минут > 0')
    return int(number)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('list')
    runner = commands.add_parser('run', help='Живые вызовы: только после явного «да» владельца')
    runner.add_argument('--tasks', default='all')
    runner.add_argument('--modes', default=','.join(MODES))
    runner.add_argument('--repeat', type=positive, default=1)
    runner.add_argument('--parallel', type=positive, default=4)
    runner.add_argument('--max-min', type=minutes, default=20)
    runner.add_argument('--keep-failed', action='store_true')
    runner.add_argument('--keep-all', action='store_true')
    runner.add_argument('--label', default='')
    reporter = commands.add_parser('report')
    reporter.add_argument('--since', help='ISO дата/время, например 2026-11-21')
    reporter.add_argument('--label')
    reviewer = commands.add_parser('review')
    reviewer.add_argument('runid')
    verdict = commands.add_parser('add-verdict')
    verdict.add_argument('runid')
    verdict.add_argument('task')
    verdict.add_argument('mode', choices=MODES)
    verdict.add_argument('legacy_verdict', choices=VERDICTS, nargs='?')
    verdict.add_argument('text', nargs='?', default='')
    verdict.add_argument('--verdict', choices=VERDICTS)
    verdict.add_argument('--round', type=positive)
    verdict.add_argument('--reviewer', choices=('codex', 'opus', 'human'))
    verdict.add_argument('--repeat', type=positive)
    verdict.add_argument('--blockers', default='')
    verdict.add_argument('--minor', default='')
    verdict.add_argument('--note', default='')
    verdict.add_argument('--tag', default='')
    retrier = commands.add_parser('retry', help='Живой вызов: только после явного «да» владельца')
    retrier.add_argument('runid')
    retrier.add_argument('task')
    retrier.add_argument('mode', choices=MODES)
    retrier.add_argument('--repeat', type=positive)
    retrier.add_argument('--max-min', type=minutes, default=20)
    retrier.add_argument('--keep-all', action='store_true')
    retrier.add_argument('--keep-failed', action='store_true')
    viewer = commands.add_parser('show')
    viewer.add_argument('runid')
    viewer.add_argument('task')
    viewer.add_argument('mode', choices=MODES)
    viewer.add_argument('--repeat', type=positive)
    importer = commands.add_parser('import')
    importer.add_argument('directory')
    args = parser.parse_args(argv)
    try:
        if args.command == 'list':
            print(table(['id', 'Тип', 'Размер', 'Описание'],
                        [[t['id'], t['type'], t['size'], t['description']] for t in tasks().values()]))
            return 0
        if args.command == 'import':
            raise ValueError('Автоимпорт gt2-N.md пока отключён: формат команд и allowed_files требует ручной проверки. '
                             'Ничего не создано. См. раздел «Добавление задачи» в README.md.')
        return {'run': run, 'retry': retry, 'show': show, 'report': report,
                'review': review, 'add-verdict': add_verdict}[args.command](args)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'Ошибка: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
