                    f'- План: `{row["plan_file"]}`', f'- Worktree: `{row["worktree"]}`',
                    f'- base_commit: `{row["base_commit"]}`', f'- Патч: `{folder / "patch.diff"}`',
                    f'- Итог Gemini: `{folder / "report.txt"}`', f'- Прогресс: `{row["progress_file"]}`',
                    f'- Приёмка: `{folder / "check.txt"}`', f'- Метаданные: `{folder / "meta.json"}`',
                    f'- Статус: {row["status"]}; механика: {row["check_ok"]}',
                    f'- Запрещённые файлы: {row["forbidden_files"]}',
