{
  "schema": 1,
  "components": [
    {
      "name": "transport",
      "title": "Связь с сервером",
      "exe": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "{bundle}\\transport\\Transport.Daemon.ps1",
        "-Home",
        "{home}",
        "-ParentPid",
        "{pid}"
      ],
      "cwd": "{bundle}",
      "restart": "always",
      "healthFile": "status/transport.json",
      "healthMaxAgeSec": 15,
      "enabledByDefault": true,
      "critical": true,
      "requiresConfig": [
        "transport.profilePath",
        "transport.channelPath"
      ]
    },
    {
      "name": "disk",
      "title": "Syncthing Tray",
      "exe": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "{bundle}\\disk\\Disk.Engine.ps1",
        "-StartTray",
        "-Home",
        "{home}"
      ],
      "cwd": "%LOCALAPPDATA%\\RemoteDisk\\tray",
      "restart": "always",
      "enabledByDefault": false,
      "critical": false,
      "requiresConfig": [
        "components.disk.enabled"
      ]
    },
    {
      "name": "control",
      "title": "Управление компьютером",
      "exe": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "{bundle}\\control\\Control.Status.ps1",
        "-Home",
        "{home}",
        "-ParentPid",
        "{pid}"
      ],
      "cwd": "{bundle}",
      "restart": "always",
      "healthFile": "status/control.json",
      "healthMaxAgeSec": 30,
      "enabledByDefault": false,
      "critical": false,
      "requiresConfig": [
        "components.control.enabled"
      ]
    },
    {
      "name": "vpn",
      "title": "VPN (весь трафик)",
      "exe": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "{bundle}\\transport\\Vpn.Tun.ps1",
        "-Home",
        "{home}",
        "-ParentPid",
        "{pid}"
      ],
      "cwd": "{bundle}",
      "restart": "never",
      "healthFile": "status/vpn.json",
      "healthMaxAgeSec": 180,
      "enabledByDefault": false,
      "critical": false,
      "commandManaged": true,
      "stopFile": "state/vpn.stop"
    }
  ],
  "menu": [],
  "binaries": []
}
